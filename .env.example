# Public client configuration only. Supply via --dart-define-from-file=config/local.json.
# Phase 1 defaults to local preview; set false only for connected mode.
LOCAL_UI_PREVIEW=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-publishable-or-anon-key
# Server-only secrets are configured in Supabase; never put them in Flutter defines.
# LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET, FIREBASE_SERVICE_ACCOUNT
